{
  "name": "spotify-visualizer",
  "version": "1.4.0",
  "description": "Audio-reactive full-screen synced lyrics visualizer for Spotify on Windows",
  "author": "Lasse Hartmann",
  "license": "MIT",
  "homepage": "https://github.com/LasseHartmann/Spotify-Visualizer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LasseHartmann/Spotify-Visualizer.git"
  },
  "bugs": {
    "url": "https://github.com/LasseHartmann/Spotify-Visualizer/issues"
  },
  "main": "dist/electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build:native": "node scripts/build-native.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:web": "npm run typecheck && vite build --mode web",
    "build": "npm run typecheck && npm run build:native && npm run build:electron && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "node scripts/generate-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/plus-jakarta-sans": "^5.2.5",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "build": {
    "appId": "com.spotifyvisualizer.app",
    "productName": "Spotify Visualizer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/wasapi-tap.exe",
        "to": "wasapi-tap.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Spotify Visualizer.exe"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
